{
  "name": "drift-ci",
  "version": "0.0.0",
  "private": true,
  "description": "Flags docs and AI-agent context files that reference things a pull request renamed or removed.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessiogarifo92/drift-ci.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "drift-ci": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "check:dist": "node scripts/check-dist.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "fixture": "node test/helpers/make-fixture-repo.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
